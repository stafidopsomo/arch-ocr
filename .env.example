# Default cloud provider: gemini, google-vision, or openrouter
CLOUD_PROVIDER=gemini

# Gemini Developer API
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
# Ordered fallback models for transient provider errors such as 429/500/503.
# Keep this short in demo mode so cost and quality remain predictable.
OCR_MODEL_FALLBACKS=gemini-2.5-flash

# Admin-only model benchmark options. Normal OCR jobs do not use this list.
OCR_BENCHMARK_MODELS=gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemma-3-4b-it,gemma-3-12b-it,gemma-3-27b-it,gemma-4-26b-a4b-it,gemma-4-31b-it
OCR_BENCHMARK_MAX_MODELS=7
OCR_BENCHMARK_MAX_PAGES=2

# Google Vision OCR baseline
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_LANGUAGE_HINTS=el,en

# OpenRouter model playground
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5-8b
# Optional OpenRouter headers:
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=arch-ocr

# Railway/demo API
OCR_STORAGE_DIR=/data/arch-ocr
OCR_ADMIN_TOKEN=change_me
OCR_DEMO_REQUIRE_TOKEN=true
OCR_ADMIN_USERNAME=admin
OCR_ADMIN_PASSWORD=change_admin_password
OCR_STARTER_USERNAME=stavret
OCR_STARTER_PASSWORD=change_starter_password
OCR_MAX_FILES_PER_PACKET=10
OCR_MAX_PAGES_PER_PACKET=20
OCR_MAX_UPLOAD_MB=100
OCR_PROVIDER_MIN_SECONDS_BETWEEN_CALLS=4
OCR_PROVIDER_MAX_REQUESTS_PER_MINUTE=10
OCR_PROVIDER_MAX_REQUESTS_PER_DAY=100
OCR_PROVIDER_MAX_RETRIES=2
OCR_PROVIDER_RETRY_BASE_SECONDS=20
OCR_PROVIDER_RETRY_MAX_SECONDS=120
OCR_PROVIDER_TIMEOUT=180
